# Rent Sync — Backend env (property-app/backend)
# Copy per environment: cp .env.example .env.development (or .env for local)
# NEVER commit .env / .env.* with real secrets — they are gitignored. Use secret manager in staging/prod.

# ---- Required (all envs) ----
# Postgres — per 11.8 keep separate DBs for dev/staging/prod, never hand-edit prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/property_app
# Strong random in prod: `openssl rand -hex 32`
JWT_SECRET=change_this_secret__use_openssl_rand_hex_32_in_prod

# ---- Optional per env ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# CORS is FAIL-CLOSED: no cross-origin requests are allowed until this is set.
# The dashboard dev server runs on http://localhost:5173; add your prod dashboard origin too
# (comma-separated for multiple origins). Omit entirely if API and dashboard share an origin.
CORS_ORIGIN=http://localhost:5173
# GOOGLE_CLIENT_ID for Google Sign-In (optional until you enable it)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- PayHero (multi-channel collection — Paybill / Till / Bank) ----
# Register an account at app.payhero.co.ke, generate an API key, get ~KES 300 free test credits for sandbox.
# Docs: docs.payhero.co.ke — Base URL defaults to https://backend.payhero.co.ke/api/v2
# PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_AUTH_TOKEN= # your Pay Hero Basic auth token (portal → API Keys). Prefix "Basic " optional.
PAYHERO_ACCOUNT_ID= # your Pay Hero account id (profile page) — required to register payment channels
# Shared secret sent as the `x-payhero-webhook-secret` header by the webhook (header-only; the webhook FAILS
# CLOSED without it — it never falls back to accepting unsigned callbacks).
PAYHERO_WEBHOOK_SECRET=
# Optional comma-separated PayHero IP allowlist for the webhook (like the old Safaricom check)
PAYHERO_IP_ALLOWLIST=
# Wallet low-balance warning threshold in KES (prepaid service wallet — a depleted wallet silently blocks STK pushes)
# PAYHERO_LOW_BALANCE_ALERT=500
#
# ---- Cron jobs ----
# CRON_SECRET=  # random string — call POST /api/cron/invoices with header x-cron-secret: <secret>

# ---- Prod only — set via secret manager, not in repo ----
# Secrets Manager: Railway/Render/Vercel env vars, or AWS Secrets Manager / Doppler / Infisical
# In prod, set these as environment variables / secrets, NOT in a file:
# DATABASE_URL (prod Postgres, e.g. Neon/Railway)
# JWT_SECRET (prod random)
# GOOGLE_CLIENT_ID (prod)
# All *_SECRET (PAYHERO_WEBHOOK_SECRET, SMS_*, CRON_SECRET) above
